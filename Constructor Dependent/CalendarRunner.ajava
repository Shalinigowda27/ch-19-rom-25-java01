class CalendarRunner {

    public static void main(String[] args) {

        Calendar calendar = new Calendar();
        Meeting meeting = new Meeting();
        Invitee invitee = new Invitee();

        calendar.calendarName = "Work Calendar";
        calendar.owner = "Alice";
        calendar.isShared = true;
        calendar.meeting = meeting;

        meeting.meetingTitle = "Project Kickoff";
        meeting.meetingTime = "2025-08-10 10:00 AM";
        meeting.invitee = invitee;

        invitee.inviteeName = "Bob";
        invitee.email = "bob@example.com";
        invitee.hasAccepted = true;

        calendar.getCalendarDetails();
    }
}
